# Server environment variables. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit secrets.

PORT=3001
FRONTEND_URL=http://localhost:5173

# Express-session secret (StarSync).
SESSION_SECRET=

# Spotify (StarSync).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=

# Cloudinary — system of record for Photos (ADR-0001).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Photos Owner auth (ADR-0002).
# PHOTOS_JWT_SECRET: a long random string used to sign the session JWT.
#   Generate one, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# PHOTOS_OWNER_PASSWORD_HASH: a bcrypt hash of the Owner password (NOT the plaintext).
#   Generate with: npm run hash-password -w server -- 'your password here'
PHOTOS_JWT_SECRET=
PHOTOS_OWNER_PASSWORD_HASH=

# Cookie flags tighten (secure + sameSite=none) when NODE_ENV=production.
# NODE_ENV=production
